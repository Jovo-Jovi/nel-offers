{
  "name": "nel-offers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "guard:naming": "node scripts/guard/naming.mjs",
    "guard:design": "node scripts/guard/design.mjs",
    "guard:literals": "node scripts/guard/literals.mjs",
    "guard:boundary": "node scripts/guard/boundary.mjs",
    "evidence": "node scripts/evidence/capture.mjs",
    "usage:record": "node scripts/usage/record.mjs",
    "usage:report": "node scripts/usage/report.mjs",
    "test:unit": "vitest run",
    "check:r2": "node --env-file=.env.local scripts/checks/r2-roundtrip.mjs",
    "scan:media-objects": "node --env-file=.env.local scripts/checks/scan-media-objects.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@fontsource/cairo": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
